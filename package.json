{
  "name": "gemini-veo-studio",
  "productName": "Gemini Veo Studio",
  "version": "1.0.0",
  "description": "Professional multi-account Gemini Veo video generation desktop manager",
  "author": "Gemini Veo Studio",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:backend": "node scripts/build-electron.mjs --watch",
    "build:backend": "node scripts/build-electron.mjs",
    "dev:frontend": "vite",
    "dev": "concurrently -k \"npm run dev:backend\" \"npm:dev:frontend\"",
    "start": "npm run build:backend && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build:backend && tsc -p tsconfig.json && vite build",
    "build:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "probe": "npx esbuild scripts/probe.ts --bundle --platform=node --format=cjs --outfile=dist-electron/probe.js --external:electron --external:better-sqlite3 --external:@ffmpeg-installer/ffmpeg --external:chokidar && npx electron dist-electron/probe.js --no-sandbox",
    "icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "better-sqlite3": "11.10.0",
    "chokidar": "3.6.0",
    "date-fns": "3.6.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-router-dom": "6.28.0",
    "zod": "3.24.1",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.49.0",
    "@tailwindcss/forms": "0.5.10",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "22.10.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  }
}
